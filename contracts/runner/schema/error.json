{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "properties": {
        "category": {
          "enum": [
            "permission_denied",
            "version_conflict",
            "invalid_transition",
            "idempotency_conflict",
            "not_found",
            "retryable",
            "rate_limited",
            "invalid_input",
            "lease_lost",
            "upgrade_required",
            "workspace_not_selected",
            "repository_not_found"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "type": "object"
    }
  },
  "required": [
    "error"
  ],
  "type": "object"
}
