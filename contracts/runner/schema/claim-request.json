{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "active_run_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "capacity": {
      "default": 1,
      "maximum": 16,
      "minimum": 0,
      "type": "integer"
    },
    "device": {
      "properties": {
        "daemon_version": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "os": {
          "enum": [
            "macOS",
            "Linux",
            "Windows",
            "other"
          ],
          "type": "string"
        },
        "os_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "providers": {
          "items": {
            "properties": {
              "installed": {
                "type": "boolean"
              },
              "name": {
                "enum": [
                  "claude-code",
                  "codex"
                ],
                "type": "string"
              },
              "signed_in": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "installed",
              "version",
              "signed_in"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "required": [
        "os",
        "os_version",
        "daemon_version",
        "providers"
      ],
      "type": "object"
    },
    "providers": {
      "items": {
        "enum": [
          "claude-code",
          "codex"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "wait_ms": {
      "default": 25000,
      "maximum": 30000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "providers"
  ],
  "type": "object"
}
