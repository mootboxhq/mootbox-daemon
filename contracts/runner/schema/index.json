{
  "error": "error.json",
  "protocol_header": "x-mootbox-runner-protocol",
  "protocol_version": 10,
  "routes": [
    {
      "method": "POST",
      "request": "start-pairing-request.json",
      "response": "start-pairing-response.json",
      "route": "/runner/pairings"
    },
    {
      "method": "POST",
      "request": "exchange-pairing-request.json",
      "response": "exchange-pairing-response.json",
      "route": "/runner/pairings/:pairingId/exchange"
    },
    {
      "method": "POST",
      "request": "claim-pairing-code-request.json",
      "response": "claim-pairing-code-response.json",
      "route": "/runner/pairings/claim-code"
    },
    {
      "method": "POST",
      "request": "start-cli-login-request.json",
      "response": "start-cli-login-response.json",
      "route": "/runner/logins"
    },
    {
      "method": "POST",
      "request": "exchange-cli-login-request.json",
      "response": "exchange-cli-login-response.json",
      "route": "/runner/logins/:loginId/exchange"
    },
    {
      "method": "POST",
      "request": "start-repository-link-request.json",
      "response": "start-repository-link-response.json",
      "route": "/runner/links"
    },
    {
      "method": "POST",
      "response": "exchange-repository-link-response.json",
      "route": "/runner/links/:linkId/exchange"
    },
    {
      "method": "POST",
      "request": "match-repositories-request.json",
      "response": "match-repositories-response.json",
      "route": "/runner/repositories/match"
    },
    {
      "method": "POST",
      "request": "register-repository-request.json",
      "response": "register-repository-response.json",
      "route": "/runner/repositories"
    },
    {
      "method": "PUT",
      "request": "upsert-connection-request.json",
      "response": "upsert-connection-response.json",
      "route": "/runner/connections"
    },
    {
      "method": "GET",
      "response": "health-response.json",
      "route": "/runner/health"
    },
    {
      "method": "POST",
      "request": "claim-request.json",
      "response": "claim-response.json",
      "route": "/runner/claim"
    },
    {
      "method": "POST",
      "request": "heartbeat-request.json",
      "response": "heartbeat-response.json",
      "route": "/runner/runs/:runId/heartbeat"
    },
    {
      "method": "POST",
      "request": "run-event-request.json",
      "response": "run-event-response.json",
      "route": "/runner/runs/:runId/events"
    },
    {
      "method": "POST",
      "request": "complete-run-request.json",
      "response": "complete-run-response.json",
      "route": "/runner/runs/:runId/complete"
    }
  ]
}
