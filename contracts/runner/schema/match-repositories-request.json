{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "remotes": {
      "items": {
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "remotes"
  ],
  "type": "object"
}
